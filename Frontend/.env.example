# Where the Payload backend is reachable.
# Server-side fetches use this; it is also sent to the browser for client calls.
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# The storefront's own public origin, with no trailing slash.
# Used to build absolute product links in the Meta product feed (/feed/meta.xml),
# which Meta resolves from its own servers where a relative path means nothing.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional analytics. Each is skipped entirely when unset.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
